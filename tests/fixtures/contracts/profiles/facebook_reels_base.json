{
  "audio_tracks": "first",
  "description": "Quality-first Reels delivery for owned/licensed short drama.",
  "keep_hdr": false,
  "name": "facebook_reels_base",
  "output_container": "mp4",
  "seed": 42,
  "seed_strategy": "fixed",
  "segmentation": {
    "mode": "keyframe",
    "scene_min_length_sec": 2.0,
    "scene_threshold": 27.0
  },
  "skip_watermark_check": false,
  "target_codec": "h264",
  "target_loudness_lufs": -16.0,
  "target_vmaf": null,
  "target_vmaf_max_retries": 2,
  "target_vmaf_step": 2,
  "transforms": [
    {
      "enabled": true,
      "id": "video.fit_aspect",
      "params": {
        "allow_upscale": true,
        "blur_sigma": 20.0,
        "mode": "pad_blur",
        "target_aspect": "9:16",
        "target_height": 1920,
        "target_width": 1080
      }
    },
    {
      "enabled": true,
      "id": "audio.loudnorm",
      "params": {
        "integrated": -16.0,
        "lra": 11.0,
        "true_peak": -1.5
      }
    }
  ]
}
